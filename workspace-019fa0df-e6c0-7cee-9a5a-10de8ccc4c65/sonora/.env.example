# Sonora configuration — all variables are optional.
# Copy this file to .env and uncomment what you need.

# Server
# PORT=3000
# HOST=127.0.0.1
# NODE_ENV=production

# Persistence (point at a mounted volume when hosting)
# SONORA_DATA_DIR=./data

# LLM refinement (sharper AI naming — falls back to deterministic engine)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Spotify provider (metadata search only — audio auto-resolved from preview providers)
# SPOTIFY_CLIENT_ID=...
# SPOTIFY_CLIENT_SECRET=...

# Disable a provider (set to 1 to disable)
# SONORA_DISABLE_ITUNES=0
# SONORA_DISABLE_AUDIUS=0
# SONORA_DISABLE_DEEZER=0
