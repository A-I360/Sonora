# Sonora configuration — all variables are optional.
# Copy this file to .env and uncomment what you need.

# Server
# PORT=3000
# HOST=127.0.0.1
# NODE_ENV=production

# Persistence (point at a mounted volume when hosting)
# SONORA_DATA_DIR=./data

# LLM refinement (sharper AI naming — falls back to deterministic engine)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Spotify connector (user OAuth — import & download playlists for offline listening).
# With credentials set, the Spotify view does REAL OAuth against your account.
# Without them (or with SPOTIFY_DEMO=1) it runs in a simulated "demo" mode so the
# whole import → download → offline playback flow still works offline.
# SPOTIFY_CLIENT_ID=...
# SPOTIFY_CLIENT_SECRET=...
# SPOTIFY_REDIRECT_URI=https://your-host/api/spotify/callback
# SPOTIFY_DEMO=1

# Disable a provider (set to 1 to disable)
# SONORA_DISABLE_ITUNES=0
# SONORA_DISABLE_AUDIUS=0
# SONORA_DISABLE_DEEZER=0
# SONORA_DISABLE_DEMO=0   # the built-in offline "Sonora Sampler" (always-on by default)
